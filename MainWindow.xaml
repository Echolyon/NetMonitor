<Window x:Class="NetMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetMonitor" Height="600" Width="1150">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FilterBox" Width="200" TextChanged="FilterBox_TextChanged"/>

            <TextBlock Text="Protokol:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="ProtocolBox" Width="80" SelectedIndex="0" SelectionChanged="Option_Changed">
                <ComboBoxItem Content="Tümü"/>
                <ComboBoxItem Content="TCP"/>
                <ComboBoxItem Content="TCP6"/>
                <ComboBoxItem Content="UDP"/>
                <ComboBoxItem Content="UDP6"/>
            </ComboBox>

            <CheckBox x:Name="OnlyEstablished" Content="Sadece ESTABLISHED"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="OnlyRisky" Content="Sadece riskli"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>

            <Button Content="CSV'ye aktar" Margin="12,0,0,0" Padding="10,2" Click="Export_Click"/>
            <Button Content="Ayarlar" Margin="6,0,0,0" Padding="10,2" Click="Settings_Click"/>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Bağlantılar">
                <DataGrid x:Name="Grid" IsReadOnly="True" AutoGenerateColumns="True"
                          AlternatingRowBackground="#F4F4F4" GridLinesVisibility="None"
                          PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Risk}" Value="Yüksek">
                                    <Setter Property="Background" Value="#FFD6D6"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Risk}" Value="Orta">
                                    <Setter Property="Background" Value="#FFF1C9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Uzak IP'yi kopyala" Click="CopyRemoteIp_Click"/>
                            <MenuItem Header="Satırı kopyala" Click="CopyRow_Click"/>
                            <MenuItem Header="Dosya konumunu aç" Click="OpenFolder_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>

            <TabItem Header="Trafik (hız)">
                <DockPanel>
                    <TextBlock x:Name="TrafficNote" DockPanel.Dock="Top" Margin="4" Foreground="DarkRed"/>
                    <DataGrid x:Name="TrafficGrid" IsReadOnly="True" AutoGenerateColumns="False"
                              AlternatingRowBackground="#F4F4F4" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Süreç" Binding="{Binding Process}" Width="180"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="İndirme" Binding="{Binding Download}" Width="120"/>
                            <DataGridTextColumn Header="Yükleme" Binding="{Binding Upload}" Width="120"/>
                            <DataGridTextColumn Header="Toplam indirilen" Binding="{Binding TotalDownloaded}" Width="130"/>
                            <DataGridTextColumn Header="Toplam yüklenen" Binding="{Binding TotalUploaded}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="HistoryTab" Header="Geçmiş">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6">
                        <TextBlock Text="Dönem:" VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <ComboBox x:Name="PeriodBox" Width="110" SelectedIndex="1" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="Son 1 saat"/>
                            <ComboBoxItem Content="Son 24 saat"/>
                            <ComboBoxItem Content="Son 7 gün"/>
                            <ComboBoxItem Content="Son 30 gün"/>
                        </ComboBox>
                        <Button Content="Geçmişi temizle" Margin="12,0,0,0" Padding="10,2" Click="ClearHistory_Click"/>
                        <TextBlock x:Name="HistoryStatus" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                    <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False"
                              AlternatingRowBackground="#F4F4F4" GridLinesVisibility="None">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Risk}" Value="Yüksek">
                                        <Setter Property="Background" Value="#FFD6D6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Risk}" Value="Orta">
                                        <Setter Property="Background" Value="#FFF1C9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="İlk görülme" Binding="{Binding FirstSeen}" Width="140"/>
                            <DataGridTextColumn Header="Son görülme" Binding="{Binding LastSeen}" Width="140"/>
                            <DataGridTextColumn Header="Süreç" Binding="{Binding Process}" Width="130"/>
                            <DataGridTextColumn Header="Protokol" Binding="{Binding Protocol}" Width="70"/>
                            <DataGridTextColumn Header="Hedef" Binding="{Binding Destination}" Width="170"/>
                            <DataGridTextColumn Header="Ülke" Binding="{Binding Country}" Width="50"/>
                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="200"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="60"/>
                            <DataGridTextColumn Header="İmza" Binding="{Binding Signature}" Width="80"/>
                            <DataGridTextColumn Header="Neden" Binding="{Binding Reason}" Width="250"/>
                            <DataGridTextColumn Header="Yol" Binding="{Binding Path}" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
