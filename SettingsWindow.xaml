<Window x:Class="NetMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Yenileme aralığı:" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <ComboBox x:Name="RefreshBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <ComboBoxItem Content="1 saniye"/>
                <ComboBoxItem Content="2 saniye"/>
                <ComboBoxItem Content="5 saniye"/>
                <ComboBoxItem Content="10 saniye"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Geçmişi sakla:" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <ComboBox x:Name="RetentionBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <ComboBoxItem Content="7 gün"/>
                <ComboBoxItem Content="30 gün"/>
                <ComboBoxItem Content="90 gün"/>
                <ComboBoxItem Content="1 yıl"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="Bildirimler:" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <CheckBox x:Name="NotifyCheck" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                      Content="Yeni riskli bağlantıda bildirim göster" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Text="Bildirim düzeyi:" VerticalAlignment="Center"/>
            <ComboBox x:Name="LevelBox" Grid.Row="3" Grid.Column="1">
                <ComboBoxItem Content="Orta ve Yüksek risk"/>
                <ComboBoxItem Content="Yalnızca Yüksek risk"/>
            </ComboBox>
        </Grid>

        <Separator Margin="0,16,0,10"/>

        <TextBlock x:Name="AboutText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="GeoText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
            <Run Text="IP Geolocation by "/><Hyperlink NavigateUri="https://db-ip.com" RequestNavigate="Hyperlink_RequestNavigate">DB-IP</Hyperlink><Run Text=" (CC BY 4.0)"/>
        </TextBlock>
        <TextBlock x:Name="DataText" TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Kaydet" Width="80" Padding="0,4" IsDefault="True" Click="Save_Click"/>
            <Button Content="İptal" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
